<Project>

	<!-- Central Package Management: all third-party package versions live here, in one place.
	     The cross-repo dep on the shared-net foundation (JorgeCostaMacia.DomainEvent) is a
	     PackageReference versioned here too; so are the transport clients (RabbitMQ.Client,
	     Confluent.Kafka). Inter-package JorgeCostaMacia.Bus.* deps (same repo) are
	     ProjectReferences (lockstep versioning), so CPM doesn't manage them. -->
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup>
		<PackageVersion Include="Confluent.Kafka" Version="2.15.1" />
		<PackageVersion Include="JorgeCostaMacia.DomainEvent" Version="8.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
		<PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
		<PackageVersion Include="Npgsql" Version="10.0.3" />
		<PackageVersion Include="Quartz" Version="4.1.0" />
		<PackageVersion Include="Quartz.Extensions.DependencyInjection" Version="4.1.0" />
		<PackageVersion Include="Quartz.Extensions.Hosting" Version="4.1.0" />
		<PackageVersion Include="Quartz.Serialization.SystemTextJson" Version="4.1.0" />
		<PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
		<PackageVersion Include="Serilog" Version="4.4.0" />
		<PackageVersion Include="Testcontainers" Version="4.15.0" />
		<PackageVersion Include="Testcontainers.Kafka" Version="4.15.0" />
		<PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
		<PackageVersion Include="Testcontainers.RabbitMq" Version="4.15.0" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
		<PackageVersion Include="xunit.v3" Version="4.0.1" />
	</ItemGroup>

</Project>
